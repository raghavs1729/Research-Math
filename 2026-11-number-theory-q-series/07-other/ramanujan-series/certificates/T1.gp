\\ Theorem 1: sum_{k>=0} (3k+2)^2 16^k/((2k+1)(6k+1)(6k+5) C(6k,3k)) = pi/(2 sqrt 3)
sg = -(k+3*n+1)*(2*k+1)/(3*(2*k+6*n+3)*(k+n+1));
rho   = 2*(n+1)*(k+3*n+1)*(k+3*n+2)*(k+3*n+3)/((2*k+6*n+3)*(2*k+6*n+5)*(2*k+6*n+7)*(k+n+1));
R     = 3*(k+3*n+2)^2/((2*k+6*n+3)*(2*k+6*n+5));
print("T1 WZ: ", rho - 1 - (subst(R,k,k+1)*sg - R) == 0);

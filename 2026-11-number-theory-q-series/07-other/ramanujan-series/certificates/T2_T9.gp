\\ Theorems 2, 9: sum_{k>=1} (8k-3) C(4k,2k)/(k(4k-1) 9^k C(2k,k)^2) = sqrt(3) pi/18  (and its harmonic companion)
sg = (2*k+1)*(2*k+n+3)*(3*k+n+1)*(3*k+n+2)*(3*k+n+3)/((2*k+n+1)*(2*k+2*n+3)*(3*k+2*n+3)*(3*k+2*n+4)*(3*k+2*n+5));
rho   = (n+1)*(4*n+3)*(4*n+5)*(2*k+n+2)*(3*k+n+1)/(9*(2*n+1)*(2*k+n+1)*(2*k+2*n+3)*(3*k+2*n+3)*(3*k+2*n+4));
R     = (3*k+2*n+2)*(6*k+8*n+5)/(9*(2*n+1)*(2*k+n+1));
print("T2 WZ: ", rho - 1 - (subst(R,k,k+1)*sg - R) == 0);

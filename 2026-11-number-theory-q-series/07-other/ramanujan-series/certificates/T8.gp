\\ Theorem 8: one-parameter deformation s of the pair of Theorem 4; pair (n*h_s, Q_s*h_s)
N = (128*n + (128*s + 64))*k^3 + (320*n^2 + (384*s + 448)*n + (-192*s^2 + 192*s + 144))*k^2 + (480*n^3 + (1056*s + 1104)*n^2 + (-352*s^2 + 736*s + 616)*n + (96*s^3 - 240*s^2 + 40*s + 92))*k + (720*n^4 + (1440*s + 1584)*n^3 + (-192*s^2 + 1440*s + 1072)*n^2 + (96*s^3 - 272*s^2 + 296*s + 260)*n + (-16*s^4 + 64*s^3 - 56*s^2 - 16*s + 15));
Q     = N/(64*(2*n+2*s+1)*(k+3*n+1)*(k+3*n+2));
sg = (4*k+6*n-2*s+1)*(4*k+6*n-2*s+3)/(16*(k+3*n+1)*(k+n-s+1));
rho   = (6*n+2*s+1)*(6*n+2*s+3)*(6*n+2*s+5)*(4*k+6*n-2*s+1)*(4*k+6*n-2*s+3)*(4*k+6*n-2*s+5)/(1024*(n+1)*(2*n+2*s+1)*(k+3*n+1)*(k+3*n+2)*(k+3*n+3)*(k+n-s+1));
print("T8 WZ: ", (n+1)*rho - n - (subst(Q,k,k+1)*sg - Q) == 0);

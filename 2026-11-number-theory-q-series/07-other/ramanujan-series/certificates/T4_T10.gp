\\ Theorems 4, 10: sum_{k>=0} (360k^3+612k^2+230k+15) C(3k,k) C(6k,3k)^2/((3k+1)(3k+2) 2^(15k)) = 32 sqrt2/pi; pair (n*h, Q*h)
sg = (4*k+6*n+1)*(4*k+6*n+3)/(16*(k+n+1)*(k+3*n+1));
rho   = 3*(6*n+1)*(6*n+5)*(4*k+6*n+1)*(4*k+6*n+3)*(4*k+6*n+5)/(1024*(n+1)*(k+n+1)*(k+3*n+1)*(k+3*n+2)*(k+3*n+3));
Q     = (64*k^3+(160*n+144)*k^2+(240*n^2+432*n+92)*k+360*n^3+612*n^2+230*n+15)/(64*(k+3*n+1)*(k+3*n+2));
print("T4 WZ: ", (n+1)*rho - n - (subst(Q,k,k+1)*sg - Q) == 0);

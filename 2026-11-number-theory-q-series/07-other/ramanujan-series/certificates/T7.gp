\\ Theorem 7: zero-sum identity (MO 506695); pair on the triangle k < n
P = (576*n + 480)*k^6 + (6912*n^2 + 10080*n + 3600)*k^5 + (31104*n^3 + 66720*n^2 + 46576*n + 10480)*k^4 + (59904*n^4 + 180000*n^3 + 195472*n^2 + 90464*n + 14920)*k^3 + (25920*n^5 + 145152*n^4 + 263360*n^3 + 211992*n^2 + 77796*n + 10454)*k^2 + (-62208*n^6 - 165120*n^5 - 137152*n^4 - 7880*n^3 + 44364*n^2 + 21138*n + 2861)*k + (-52992*n^7 - 208128*n^6 - 334416*n^5 - 279712*n^4 - 127288*n^3 - 29432*n^2 - 2609*n + 12);
R     = P/(3*(6*n+1)*(6*n+5)*(k-n)*(2*k+4*n+3)*(2*k+6*n+3)*(2*k+6*n+5)*(4*k+4*n+3));
sg = -(4*k+4*n+7)*(k+1)*(n-k-1)*(2*k+2*n+1)*(2*k+2*n+2)/((4*k+4*n+3)*(2*k+2*n+3)*(2*k+2*n+4)*(k+2*n+3/2)*(k+3*n+3/2));
rho   = (4*k+4*n+7)*(4*n+1)*(4*n+2)*(4*n+3)*(4*n+4)*(2*n+1)*(2*n+2)*(2*k+2*n+1)*(2*k+2*n+2)/(64*(4*k+4*n+3)*(n-k)*(2*k+2*n+3)*(2*k+2*n+4)*(k+2*n+3/2)*(k+2*n+5/2)*(k+3*n+3/2)*(k+3*n+5/2)*(k+3*n+7/2));
print("T7 WZ: ", rho - 1 - (subst(R,k,k+1)*sg - R) == 0);
sig1 = subst(subst(subst(sg,n,m+1),k,m-1),m,n);   \\ sg(n+1, n-1)
print("T7 boundary k=n-1: ", subst(rho,k,n-1) - 1 == -subst(rho,k,n-1)*sig1 - subst(R,k,n-1));

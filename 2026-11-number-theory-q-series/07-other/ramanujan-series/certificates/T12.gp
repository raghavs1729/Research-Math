\\ Theorem 12 (Guillera's conjecture, arXiv:1802.02023, level 2, z = -1/48, shift 1/2):
\\   sum_{n>=0} (28n+17) (1)_n (3/4)_n (5/4)_n / ((3/2)_n^3 (-48)^n) = 32 log(27/16)
sg = (k+n+1)*(4*k+4*n+7)*(6*k+4*n+3)*(6*k+4*n+5)*(6*k+4*n+7)/(4*(2*k+2*n+3)*(3*k+4*n+4)*(3*k+4*n+5)*(3*k+4*n+6)*(4*k+4*n+3));
rho   = -(n+1)*(4*n+3)*(4*n+5)*(k+n+1)*(4*k+4*n+7)*(6*k+4*n+3)*(6*k+4*n+5)/(12*(2*n+1)*(2*k+2*n+3)*(3*k+4*n+4)*(3*k+4*n+5)*(3*k+4*n+6)*(3*k+4*n+7)*(4*k+4*n+3));
R     = (36*k^3+(156*n+120)*k^2+(232*n^2+362*n+138)*k+112*n^3+264*n^2+203*n+51)/(3*(2*n+1)*(3*k+4*n+4)*(4*k+4*n+3));
print("T12 WZ: ", rho - 1 - (subst(R,k,k+1)*sg - R) == 0);
print("T12 compat: ", rho*subst(sg,n,n+1) - sg*subst(rho,k,k+1) == 0);

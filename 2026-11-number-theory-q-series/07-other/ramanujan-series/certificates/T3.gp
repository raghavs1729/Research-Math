\\ Theorem 3: sum_{k>=1} (4k-1) 3^k/((2k-1) k^2 C(2k,k) C(3k,k)) = 2 L_{-3}(2);  x real, F(n,x) = c_n (3/4)^x (-x)_{2n} Gamma(x+n+1)/Gamma(x+n+3/2)
sg = 3/4*(x+1)*(x+n+1)/((x+1-2*n)*(x+n+3/2));
cr    = 1/9*(3*n+3/2)*(3*n+5/2)*(3*n+7/2)*(n+1)^2/((2*n+1)*(2*n+2)*(3*n+1)*(3*n+2)*(3*n+3)*(n+5/6)*(n+7/6));
rho   = cr*(2*n-x)*(2*n+1-x)*(x+n+1)/(x+n+3/2);
R     = (8*n^2+6*n-(2*n+3)*x-x^2)/((3*n+1)*(3*n+2));
print("T3 WZ: ", rho - 1 - (subst(R,x,x+1)*sg - R) == 0);

\\ Theorem 13 (Cohen-Guillera, half-shift of Cullen's 1/pi^4 series): sum P(n+1/2) n!^16 (4n+2)!/(2n+1)!^10 = 2048 pi^4/15
\\ pair U(m,k) = (-1)^m E(a+m,k), V = R*U;  sg = E(n,k+1)/E(n,k), rho = -E(n+1,k)/E(n,k)
sg = (128*k^7 + (1344*n + 480)*k^6 + (5568*n^2 + 4480*n + 720)*k^5 + (12160*n^3 + 15680*n^2 + 5920*n + 560)*k^4 + (15360*n^4 + 27520*n^3 + 16960*n^2 + 4000*n + 240)*k^3 + (11328*n^5 + 26080*n^4 + 22560*n^3 + 8880*n^2 + 1460*n + 54)*k^2 + (4544*n^6 + 12800*n^5 + 14320*n^4 + 8000*n^3 + 2260*n^2 + 272*n + 5)*k + (768*n^7 + 2560*n^6 + 3520*n^5 + 2560*n^4 + 1040*n^3 + 224*n^2 + 20*n))/(128*k^7 + (1344*n + 864)*k^6 + (5568*n^2 + 7936*n + 2448)*k^5 + (10880*n^3 + 28480*n^2 + 19040*n + 3760)*k^4 + (7680*n^4 + 48640*n^3 + 56320*n^2 + 23680*n + 3360)*k^3 + (-6144*n^5 + 35840*n^4 + 76800*n^3 + 53760*n^2 + 16000*n + 1728)*k^2 + (-13312*n^6 + 2048*n^5 + 44800*n^4 + 51200*n^3 + 24640*n^2 + 5504*n + 464)*k + (-6144*n^7 - 7168*n^6 + 6656*n^5 + 16640*n^4 + 12160*n^3 + 4288*n^2 + 736*n + 48));
rho = ((-8192*n^5 - 20480*n^4 - 20480*n^3 - 10240*n^2 - 2560*n - 256)*k^11 + (-176128*n^6 - 528384*n^5 - 660480*n^4 - 440320*n^3 - 165120*n^2 - 33024*n - 2752)*k^10 + (-1597440*n^7 - 5652480*n^6 - 8538112*n^5 - 7137280*n^4 - 3566080*n^3 - 1064960*n^2 - 176000*n - 12416)*k^9 + (-7925760*n^8 - 32788480*n^7 - 58775552*n^6 - 59651072*n^5 - 37493760*n^4 - 14944000*n^3 - 3687040*n^2 - 514496*n - 31056)*k^8 + (-23224320*n^9 - 112455680*n^8 - 237740032*n^7 - 288415744*n^6 - 221434880*n^5 - 111592960*n^4 - 36897280*n^3 - 7709696*n^2 - 921952*n - 47920)*k^7 + (-39751680*n^10 - 230256640*n^9 - 579679232*n^8 - 840155136*n^7 - 778938880*n^6 - 483546624*n^5 - 203628160*n^4 - 57391616*n^3 - 10337488*n^2 - 1070000*n - 47972)*k^6 + (-33300480*n^11 - 257761280*n^10 - 816965632*n^9 - 1454030848*n^8 - 1643545600*n^7 - 1250139136*n^6 - 655896832*n^5 - 237723136*n^4 - 58270624*n^3 - 9164320*n^2 - 825608*n - 31776)*k^5 + (4730880*n^12 - 82063360*n^11 - 522555392*n^10 - 1334850560*n^9 - 1967489280*n^8 - 1885478400*n^7 - 1237232640*n^6 - 566869632*n^5 - 180810480*n^4 - 39129840*n^3 - 5420720*n^2 - 425380*n - 13843)*k^4 + (40304640*n^13 + 158801920*n^12 + 158302208*n^11 - 284516352*n^10 - 1033175040*n^9 - 1476247040*n^8 - 1289461760*n^7 - 760328192*n^6 - 312134912*n^5 - 89129120*n^4 - 17220480*n^3 - 2112160*n^2 - 143648*n - 3818)*k^3 + (39976960*n^14 + 220692480*n^13 + 510169088*n^12 + 594210816*n^11 + 239656960*n^10 - 304337920*n^9 - 593237760*n^8 - 513403392*n^7 - 282230784*n^6 - 105998080*n^5 - 27454800*n^4 - 4773200*n^3 - 519168*n^2 - 30196*n - 605)*k^2 + (17825792*n^15 + 114688000*n^14 + 326402048*n^13 + 533438464*n^12 + 533749760*n^11 + 300089344*n^10 + 25989120*n^9 - 111447552*n^8 - 109003776*n^7 - 57935360*n^6 - 20248960*n^5 - 4804640*n^4 - 755488*n^3 - 72704*n^2 - 3520*n - 42)*k + (3145728*n^16 + 22544384*n^15 + 72941568*n^14 + 140214272*n^13 + 176455680*n^12 + 149405696*n^11 + 81506304*n^10 + 21424128*n^9 - 6217728*n^8 - 9461760*n^7 - 5054720*n^6 - 1666944*n^5 - 364928*n^4 - 52032*n^3 - 4400*n^2 - 168*n))/(8388608*n^5*k^11 + (180355072*n^6 + 127926272*n^5)*k^10 + (1761607680*n^7 + 2495610880*n^6 + 870318080*n^5)*k^9 + (10317987840*n^8 + 21894266880*n^7 + 15246295040*n^6 + 3481272320*n^5)*k^8 + (40265318400*n^9 + 113749524480*n^8 + 118614917120*n^7 + 54064578560*n^6 + 9080668160*n^5)*k^7 + (109924319232*n^10 + 387553689600*n^9 + 537877544960*n^8 + 367001600000*n^7 + 122997964800*n^6 + 16183721984*n^5)*k^6 + (214211493888*n^11 + 904761704448*n^10 + 1566656430080*n^9 + 1422204600320*n^8 + 713199452160*n^7 + 187145650176*n^6 + 20055064576*n^5)*k^5 + (297963356160*n^12 + 1465657589760*n^11 + 3039360450560*n^10 + 3441007001600*n^9 + 2294703718400*n^8 + 900433182720*n^7 + 192287866880*n^6 + 17217617920*n^5)*k^4 + (289910292480*n^13 + 1626718863360*n^12 + 3927210721280*n^11 + 5322404003840*n^10 + 4424151859200*n^9 + 2307034972160*n^8 + 736100352000*n^7 + 131197829120*n^6 + 9982443520*n^5)*k^3 + (187904819200*n^14 + 1183800360960*n^13 + 3258806435840*n^12 + 5139196805120*n^11 + 5110675537920*n^10 + 3319372185600*n^9 + 1406098472960*n^8 + 373964144640*n^7 + 56539217920*n^6 + 3690987520*n^5)*k^2 + (73014444032*n^15 + 510027366400*n^14 + 1575716126720*n^13 + 2831994060800*n^12 + 3274912563200*n^11 + 2542553530368*n^10 + 1339996241920*n^9 + 472446402560*n^8 + 106367549440*n^7 + 13757317120*n^6 + 771751936*n^5)*k + (12884901888*n^16 + 98784247808*n^15 + 338228674560*n^14 + 681826058240*n^13 + 897916600320*n^12 + 809869770752*n^11 + 509557604352*n^10 + 223136972800*n^9 + 66437775360*n^8 + 12750684160*n^7 + 1409286144*n^6 + 67108864*n^5));
R = ((-52480*n^2 - 11520*n - 832)*k^9 + (-839680*n^3 - 499200*n^2 - 82432*n - 4992)*k^8 + (-5751040*n^4 - 5753600*n^3 - 1884672*n^2 - 248384*n - 12784)*k^7 + (-21654528*n^5 - 31668480*n^4 - 16398592*n^3 - 3809536*n^2 - 413952*n - 18224)*k^6 + (-47116032*n^6 - 96681728*n^5 - 72036672*n^4 - 25461888*n^3 - 4606864*n^2 - 420336*n - 15820)*k^5 + (-53329920*n^7 - 164899840*n^6 - 174126592*n^5 - 87815680*n^4 - 23617280*n^3 - 3485120*n^2 - 269280*n - 8576)*k^4 + (-8712960*n^8 - 129480960*n^7 - 222809472*n^6 - 162108992*n^5 - 62052160*n^4 - 13434160*n^3 - 1657640*n^2 - 108396*n - 2841)*k^3 + (53591040*n^9 + 21564160*n^8 - 107831552*n^7 - 145489024*n^6 - 82449344*n^5 - 25461440*n^4 - 4586160*n^3 - 479096*n^2 - 26192*n - 527)*k^2 + (61501440*n^10 + 110274560*n^9 + 46320128*n^8 - 35344896*n^7 - 46153472*n^6 - 21791104*n^5 - 5626880*n^4 - 860256*n^3 - 76288*n^2 - 3376*n - 42)*k + (22364160*n^11 + 55291904*n^10 + 51304448*n^9 + 17887232*n^8 - 3723264*n^7 - 5776896*n^6 - 2350848*n^5 - 517376*n^4 - 67904*n^3 - 5072*n^2 - 168*n))/(524288*n^5*k^6 + (6029312*n^6 + 2752512*n^5)*k^5 + (28835840*n^7 + 26214400*n^6 + 5898240*n^5)*k^4 + (73400320*n^8 + 99614720*n^7 + 44564480*n^6 + 6553600*n^5)*k^3 + (104857600*n^9 + 188743680*n^8 + 125829120*n^7 + 36700160*n^6 + 3932160*n^5)*k^2 + (79691776*n^10 + 178257920*n^9 + 157286400*n^8 + 68157440*n^7 + 14417920*n^6 + 1179648*n^5)*k + (25165824*n^11 + 67108864*n^10 + 73400320*n^9 + 41943040*n^8 + 13107200*n^7 + 2097152*n^6 + 131072*n^5));
print("T13 WZ: ", rho - 1 - (subst(R,k,k+1)*sg - R) == 0);
print("T13 compat: ", rho*subst(sg,n,n+1) - sg*subst(rho,k,k+1) == 0);
print("T13 R(n,0): ", subst(R,k,0) == (2*n-1)*(43680*n^4+20632*n^3+4340*n^2+466*n+21)/(16384*n^4*(6*n+1)));

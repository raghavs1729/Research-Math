\\ Theorem 11: sum_{k>=0} (1344k^3+944k^2+156k+9) C(2k,k)^2 C(4k,2k)^3/((2k+1) 2^(22k)) = 64 sqrt2/pi^2; pair on the triangle k < n
NUM = (3145728*n + 1310720)*k^6 + (-6291456*n^2 + 3670016*n + 2621440)*k^5 + (-786432*n^3 - 11337728*n^2 - 344064*n + 1724416)*k^4 + (9437184*n^4 + 786432*n^3 - 8716288*n^2 - 1884160*n + 376832)*k^3 + (-8060928*n^5 + 10010624*n^4 + 3973120*n^3 - 3434496*n^2 - 892672*n - 15936)*k^2 + (2752512*n^6 - 6324224*n^5 + 1916928*n^4 + 2363392*n^3 - 525824*n^2 - 170112*n - 12672)*k + (-344064*n^7 + 1134592*n^6 - 922624*n^5 - 195328*n^4 + 318016*n^3 - 1680*n^2 - 10044*n - 945);
R     = NUM/(131072*n*(2*n-1)*(2*n+1)*(4*n-1)*(k-n)^2*(2*k+1));
rf4(z) = z*(z+1)*(z+2)*(z+3);
sg = (2*k+3)*(n-k-1)^2*rf4(4*k+2*n+1/2)/((2*k+1)*(n+k+1)^2*rf4(4*k-2*n+9/2));
rho   = (n+3/4)^2*(n+1/4)*(4*k+2*n+1/2)*(4*k+2*n+3/2)*(4*k-2*n+5/2)*(4*k-2*n+7/2)/(512*n*(n-1/4)*(2*n-1)*(n-k)^2*(n+k+1)^2);
print("T11 WZ: ", rho - 1 - (subst(R,k,k+1)*sg - R) == 0);
sig1 = subst(subst(subst(sg,n,m+1),k,m-1),m,n);   \\ sg(n+1, n-1)
print("T11 boundary k=n-1: ", subst(rho,k,n-1) - 1 == -subst(rho,k,n-1)*sig1 - subst(R,k,n-1));

private lemma harmonic_lower (n : ℕ) :
    ((∑ i ∈ Finset.range n, 10 ^ 9 / (i + 1) : ℕ) : ℝ) / 10 ^ 9 ≤ ((harmonic n : ℚ) : ℝ) := by
  unfold harmonic
  rw [Rat.cast_sum, Nat.cast_sum, Finset.sum_div]
  apply Finset.sum_le_sum
  intro i _
  have h : ((10 ^ 9 / (i + 1) : ℕ) : ℝ) ≤ ((10 ^ 9 : ℕ) : ℝ) / ((i + 1 : ℕ) : ℝ) :=
    Nat.cast_div_le
  have e1 : ((10 ^ 9 : ℕ) : ℝ) = 10 ^ 9 := by norm_num
  rw [e1] at h
  rw [div_le_iff₀ (by positivity), Rat.cast_inv, Rat.cast_natCast]
  calc ((10 ^ 9 / (i + 1) : ℕ) : ℝ) ≤ 10 ^ 9 / ((i + 1 : ℕ) : ℝ) := h
    _ = (((i + 1 : ℕ) : ℝ))⁻¹ * 10 ^ 9 := by ring


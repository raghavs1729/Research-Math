    intro N
    induction N with
    | zero => simp
    | succ N ih =>
      rw [Finset.sum_range_succ]
      linarith [h N]
  refine le_of_tendsto' hs.hasSum.tendsto_sum_nat (fun N => ?_)
  linarith [key N, hP N]


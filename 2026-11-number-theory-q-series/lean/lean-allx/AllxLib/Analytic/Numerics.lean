    have h4 : Real.log 4 ≤ Real.log (x + 1) := Real.log_le_log (by norm_num) (by linarith)
    have := Real.log_two_gt_d9
    have := log_four
    linarith
  obtain ⟨δ, hδ⟩ : ∃ δ, δ = Real.log (x + 1) - Real.log x := ⟨_, rfl⟩
  obtain ⟨L, hLdef⟩ : ∃ L, L = Real.log (x + 1) := ⟨_, rfl⟩
  have hδx : δ * x ≤ 1 := by
    have h1 : Real.log ((x + 1) / x) ≤ (x + 1) / x - 1 :=
      Real.log_le_sub_one_of_pos (by positivity)
    rw [Real.log_div hx1.ne' hx0.ne'] at h1
    have h2 : (x + 1) / x - 1 = 1 / x := by field_simp; ring
    rw [h2, ← hδ] at h1
    calc δ * x ≤ 1 / x * x := mul_le_mul_of_nonneg_right h1 hx0.le
      _ = 1 := by field_simp
  have hδ3 : δ * 3 ≤ 1 := by
    by_cases hδ0 : 0 ≤ δ
    · nlinarith
    · linarith
  have hδxx : δ * x * x ≤ 1 * x := mul_le_mul_of_nonneg_right hδx hx0.le
  have hl : Real.log x = L - δ := by linarith
  unfold potU
  rw [hl, ← hLdef, ← sub_nonneg]
  rw [← hLdef] at hL
  have e : (L - δ + 1) / x - (L + 1) / (x + 1) - L / (x + 1) ^ 2
      = (L + x + 1 - δ * (x + 1) ^ 2) / (x * (x + 1) ^ 2) := by
    field_simp
    ring
  rw [e]
  apply div_nonneg
  · nlinarith
  · positivity


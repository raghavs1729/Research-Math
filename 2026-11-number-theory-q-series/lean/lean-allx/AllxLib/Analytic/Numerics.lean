/-- The values of `χ₄` on naturals, as real numbers. -/
private lemma chi4_cases (n : ℕ) :
    (n % 4 = 3 ∧ ((ZMod.χ₄ (n : ZMod 4) : ℤ) : ℝ) = -1) ∨
    (n % 2 = 0 ∧ ((ZMod.χ₄ (n : ZMod 4) : ℤ) : ℝ) = 0) ∨
    (n % 4 = 1 ∧ ((ZMod.χ₄ (n : ZMod 4) : ℤ) : ℝ) = 1) := by
  rw [ZMod.χ₄_nat_eq_if_mod_four]
  have h4 : n % 4 < 4 := Nat.mod_lt _ (by norm_num)
  by_cases h2 : n % 2 = 0
  · right; left
    exact ⟨h2, by simp [h2]⟩
  · by_cases h1 : n % 4 = 1
    · right; right
      exact ⟨h1, by simp [h2, h1]⟩
    · left
      exact ⟨by omega, by simp [h2, h1]⟩

/-- The summand `Λ(n) (−χ₋₄(n)) / n^s`. -/
private def cTerm (s n : ℕ) : ℝ :=
  ArithmeticFunction.vonMangoldt n * (-((ZMod.χ₄ (n : ZMod 4) : ℤ) : ℝ)) / (n : ℝ) ^ s

private lemma vm_nonneg (n : ℕ) : 0 ≤ ArithmeticFunction.vonMangoldt n :=
  ArithmeticFunction.vonMangoldt_nonneg

private lemma vm_le_log (n : ℕ) : ArithmeticFunction.vonMangoldt n ≤ Real.log n :=
  ArithmeticFunction.vonMangoldt_le_log

private lemma cTerm_mod3 (s n : ℕ) (h : n % 4 = 3) :
    cTerm s n = ArithmeticFunction.vonMangoldt n / (n : ℝ) ^ s := by
  unfold cTerm
  rcases chi4_cases n with ⟨_, hc⟩ | ⟨h', _⟩ | ⟨h', _⟩
  · rw [hc]; ring
  · omega
  · omega

private lemma cTerm_mod1 (s n : ℕ) (h : n % 4 = 1) :
    cTerm s n = -(ArithmeticFunction.vonMangoldt n / (n : ℝ) ^ s) := by
  unfold cTerm
  rcases chi4_cases n with ⟨h', _⟩ | ⟨h', _⟩ | ⟨_, hc⟩
  · omega
  · omega
  · rw [hc]; ring

private lemma cTerm_even (s n : ℕ) (h : n % 2 = 0) : cTerm s n = 0 := by
  unfold cTerm
  rcases chi4_cases n with ⟨h', _⟩ | ⟨_, hc⟩ | ⟨h', _⟩
  · omega
  · rw [hc]; simp
  · omega

private lemma vm_div_nonneg (s n : ℕ) : 0 ≤ ArithmeticFunction.vonMangoldt n / (n : ℝ) ^ s :=
  div_nonneg (vm_nonneg n) (by positivity)

/-- Terms outside the progression `3 mod 4` are nonpositive. -/
private lemma cTerm_nonpos (s n : ℕ) (hn : n % 4 ≠ 3) : cTerm s n ≤ 0 := by
  rcases chi4_cases n with ⟨h, _⟩ | ⟨h, _⟩ | ⟨h, _⟩
  · exact absurd h hn
  · rw [cTerm_even s n h]
  · rw [cTerm_mod1 s n h]
    linarith [vm_div_nonneg s n]

/-- Terms outside the progression `1 mod 4` are nonnegative. -/
private lemma cTerm_nonneg (s n : ℕ) (hn : n % 4 ≠ 1) : 0 ≤ cTerm s n := by
  rcases chi4_cases n with ⟨h, _⟩ | ⟨h, _⟩ | ⟨h, _⟩
  · rw [cTerm_mod3 s n h]
    exact vm_div_nonneg s n
  · rw [cTerm_even s n h]
  · exact absurd h hn

private lemma vm_div_le_log (s n : ℕ) :
    ArithmeticFunction.vonMangoldt n / (n : ℝ) ^ s ≤ Real.log n / (n : ℝ) ^ s :=
  div_le_div_of_nonneg_right (vm_le_log n) (by positivity)

private lemma cTerm_le_log (s n : ℕ) (h : n % 4 = 3) :
    cTerm s n ≤ Real.log n / (n : ℝ) ^ s := by
  rw [cTerm_mod3 s n h]
  exact vm_div_le_log s n

private lemma cTerm_ge_log (s n : ℕ) (h : n % 4 = 1) :
    -(Real.log n / (n : ℝ) ^ s) ≤ cTerm s n := by
  rw [cTerm_mod1 s n h]
  linarith [vm_div_le_log s n]


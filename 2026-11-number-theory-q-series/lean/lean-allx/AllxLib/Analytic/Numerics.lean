/-- The potential `D(t) = (log t + 1) / (4 t)`, a primitive-type majorant for
`t ↦ log t / t²` along steps of length `4`. -/
private def pot (t : ℝ) : ℝ := (Real.log t + 1) / (4 * t)

private lemma pot_nonneg (t : ℝ) (ht : 1 ≤ t) : 0 ≤ pot t := by
  unfold pot
  have := Real.log_nonneg ht
  positivity

/-- Key step inequality: `log(x+4)/(x+4)² ≤ D(x) − D(x+4)` for `x ≥ 7`. -/
private lemma pot_step (x : ℝ) (hx : 7 ≤ x) :
    Real.log (x + 4) / (x + 4) ^ 2 ≤ pot x - pot (x + 4) := by
  have hx0 : 0 < x := by linarith
  have hx4 : 0 < x + 4 := by linarith
  -- `L = log (x+4) ≥ 3 log 2 ≥ 11/7`
  have hL : 11 / 7 ≤ Real.log (x + 4) := by
    have h8 : Real.log 8 ≤ Real.log (x + 4) := Real.log_le_log (by norm_num) (by linarith)
    have := Real.log_two_gt_d9
    have := log_eight
    linarith
  -- `δ = log (x+4) − log x ≤ 4/x`
  obtain ⟨δ, hδ⟩ : ∃ δ, δ = Real.log (x + 4) - Real.log x := ⟨_, rfl⟩
  obtain ⟨L, hLdef⟩ : ∃ L, L = Real.log (x + 4) := ⟨_, rfl⟩
  have hδx : δ * x ≤ 4 := by
    have h1 : Real.log ((x + 4) / x) ≤ (x + 4) / x - 1 :=
      Real.log_le_sub_one_of_pos (by positivity)
    rw [Real.log_div hx4.ne' hx0.ne'] at h1
    have h2 : (x + 4) / x - 1 = 4 / x := by field_simp; ring
    rw [h2, ← hδ] at h1
    calc δ * x ≤ 4 / x * x := mul_le_mul_of_nonneg_right h1 hx0.le
      _ = 4 := by field_simp
  have hδ7 : δ * 7 ≤ 4 := by
    by_cases hδ0 : 0 ≤ δ
    · nlinarith
    · linarith
  have hδxx : δ * x * x ≤ 4 * x := mul_le_mul_of_nonneg_right hδx hx0.le
  have hl : Real.log x = L - δ := by linarith
  unfold pot
  rw [hl, ← hLdef, ← sub_nonneg]
  rw [← hLdef] at hL
  have e : (L - δ + 1) / (4 * x) - (L + 1) / (4 * (x + 4)) - L / (x + 4) ^ 2
      = (16 * L + 4 * (x + 4) - δ * (x + 4) ^ 2) / (4 * x * (x + 4) ^ 2) := by
    field_simp
    ring
  rw [e]
  apply div_nonneg
  · nlinarith
  · positivity


  decide +kernel

/-- `γ ≥ 0.5752`, from `γ > H_255 − log 256`. -/
private lemma gamma_lower : (5752 : ℝ) / 10000 ≤ Real.eulerMascheroniConstant := by
  have h1 := Real.eulerMascheroniSeq_lt_eulerMascheroniConstant 255
  unfold Real.eulerMascheroniSeq at h1
  have h2 := harmonic_lower 255
  rw [harmonic_sum] at h2
  have e : Real.log (((255 : ℕ) : ℝ) + 1) = 8 * Real.log 2 := by
    rw [show (((255 : ℕ) : ℝ) + 1) = 2 ^ 8 by norm_num, Real.log_pow]; norm_num
  rw [e] at h1
  have := Real.log_two_lt_d9
  have e2 : ((6120438589 : ℕ) : ℝ) / 10 ^ 9 = 6120438589 / 1000000000 := by norm_num
  rw [e2] at h2
  linarith

/-- `log π ≥ (33/20) log 2`, from `π > 3.1415` and `3.1415^20 ≥ 2^33`. -/
private lemma log_pi_lower : 33 / 20 * Real.log 2 ≤ Real.log π := by
  have h1 : (2 : ℝ) ^ 33 ≤ π ^ 20 := by
    have h2 : (3.1415 : ℝ) ^ 20 ≤ π ^ 20 :=

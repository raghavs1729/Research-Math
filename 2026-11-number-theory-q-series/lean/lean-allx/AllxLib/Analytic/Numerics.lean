private lemma log_le_of_pow_le {p : ℝ} (hp : 0 < p) (k m : ℕ) (h : p ^ k ≤ 2 ^ m) :
    (k : ℝ) * Real.log p ≤ (m : ℝ) * Real.log 2 := by
  have := Real.log_le_log (pow_pos hp k) h
  rwa [Real.log_pow, Real.log_pow] at this

private lemma log_ge_of_pow_le {p : ℝ} (k m : ℕ) (h : 2 ^ m ≤ p ^ k) :
    (m : ℝ) * Real.log 2 ≤ (k : ℝ) * Real.log p := by
  have := Real.log_le_log (by positivity) h
  rwa [Real.log_pow, Real.log_pow] at this

